{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "folstudentphotos",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  // Builds the React frontend into ./dist before every deploy.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The Worker handles API calls and HTML pages (to set the page language before it loads).
    "run_worker_first": ["/", "/index.html", "/estudiantes/*", "/api/*", "/entrar", "/clave", "/admin"]
  },
  "vars": { "ADMIN_EMAIL": "phillip@insightful.media" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fol-gallery-db",
      "database_id": "b0621aac-99be-4ccc-ae0c-a14e64ed4a4f"
    }
  ],
  // Photos: originals (private), web and thumb versions. Create the bucket once with
  // `npx wrangler r2 bucket create fol-gallery-photos` (or in the Cloudflare dashboard) before deploying.
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "fol-gallery-photos" }],
  // Draft translations (Spanish to English) for statements.
  "ai": { "binding": "AI" },
  "observability": { "enabled": true }
}
